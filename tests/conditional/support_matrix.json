    {
      "id": "bivariate-gaussian-rotation-90",
      "model_id": "bivariate-gaussian",
      "probe": "bivariate_gaussian_rotation_90",
      "configuration": {"rotate": 90},
      "expected_exception": "ValueError",
      "reason": "Bivariate Gaussian supports only rotation 0."
    },
    {
      "id": "bivariate-frank-rotation-90",
      "model_id": "bivariate-frank",
      "probe": "bivariate_frank_rotation_90",
      "configuration": {"rotate": 90},
