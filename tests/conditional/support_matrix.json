        "supports_pair_ops": true,
        "supports_native_point_ops": true,
        "supports_gas": false,
        "supports_scar_ou": false,
        "supports_scar_mc": false,
        "supports_latent_grid": false,
        "supports_conditional_sampling": true,
        "has_dynamic_scalar_parameter": false
      },
      "signatures": {
        "predict": [
          "n", "u", "rng", "given", "horizon",
          "predictive_r_mode", "predict_config"
        ]
      },
      "notes": "Rotation is accepted by the constructor but is semantically irrelevant; only rotation 0 is a distinct test cell."
