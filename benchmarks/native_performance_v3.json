{
  "schema_version": 3,
  "manifest_id": "pyscarcopula-native-performance-v3",
  "description": "Native performance workload matrix. Case ids and inputs are immutable after a baseline is accepted; changes require a new schema/manifest version.",
  "protocol": {
    "timer": "time.perf_counter_ns",
    "warmup_calls": 3,
    "paired_samples": 8,
    "minimum_sample_seconds": 0.05,
    "order": "A/B/B/A repeating",
    "noise_envelope": "q95(abs(B/A - 1)); diagnostic only",
    "regression_policy": {
      "maximum_runtime_ratio": 2.0,
      "maximum_python_allocation_count_ratio": 2.0,
      "minimum_python_allocation_count_increase": 64,
