      "maximum_parallel_scaling_loss_ratio": 2.0,
      "require_checksum_match": true,
      "require_domain_diagnostics_match": true
    },
    "timed_region_excludes": [
      "build",
      "import",
      "fixture generation",
      "RNG fixture generation"
    ],
    "required_metrics": [
      "seconds",
      "checksum",
      "python_allocation_count",
      "python_allocated_bytes",
      "python_peak_bytes",
      "process_peak_rss_bytes",
      "domain_diagnostics"
    ]
  },
