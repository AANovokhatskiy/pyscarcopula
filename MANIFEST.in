# Include in source distribution (sdist)
include LICENSE.txt
include README.md
include ARCHITECTURE.md
include pyproject.toml
include tools/check_cpp_architecture.py
recursive-include tests *.py
recursive-include tests/fixtures *.json
recursive-include docs *.md
recursive-include data *.csv
recursive-include pyscarcopula/_cpp *.cpp *.hpp

# Exclude generated/cache files
global-exclude __pycache__
global-exclude *.pyc
