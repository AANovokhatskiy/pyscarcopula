# Include in source distribution (sdist)
include LICENSE.txt
include README.md
include ARCHITECTURE.md
include pyproject.toml
include tools/check_cpp_architecture.py
include tools/build_cpp_tests.py
include tools/benchmark_timing.py
include tools/aggregate_release_validation.py
include tools/allocation_probe.c
include tools/native_dependency_audit.py
include tools/write_release_metadata.py
recursive-include tests *.py
recursive-include tests/cpp *.cpp
recursive-include tests/fixtures *.json
recursive-include docs *.md
recursive-exclude data *.csv
include data/crypto_prices.csv
recursive-include pyscarcopula/_cpp *.cpp *.hpp *.def
recursive-include pyscarcopula/_cpp/build_support *.py

# Exclude generated/cache files
global-exclude __pycache__
global-exclude *.pyc
